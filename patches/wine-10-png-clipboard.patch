+/* Convert only when Windows requests CF_DIB; preserve the original PNG target. */
+static void *import_image_png( Atom type, const void *data, size_t size, size_t *ret_size )
+{
+    png_image image = { .version = PNG_IMAGE_VERSION };
+    const png_color white = { 255, 255, 255 };
+    BITMAPINFOHEADER *header = NULL;
+    size_t stride, pixels;
+
+    if (type != x11drv_atom(image_png)) return NULL;
+    if (!png_image_begin_read_from_memory( &image, data, size )) goto done;
+    if (!image.width || !image.height || image.width > 16384 || image.height > 16384 ||
+        (size_t)image.width * image.height > 32 * 1024 * 1024) goto done;
+
+    image.format = PNG_FORMAT_BGR;
+    stride = ((size_t)image.width * 3 + 3) & ~(size_t)3;
+    pixels = stride * image.height;
+    if (!(header = calloc( 1, sizeof(*header) + pixels ))) goto done;
+    if (!png_image_finish_read( &image, &white, header + 1, -(png_int_32)stride, NULL ))
+    {
+        free( header );
+        header = NULL;
+        goto done;
+    }
+    header->biSize = sizeof(*header);
+    header->biWidth = image.width;
+    header->biHeight = image.height;
+    header->biPlanes = 1;
+    header->biBitCount = 24;
+    header->biCompression = BI_RGB;
+    header->biSizeImage = pixels;
+    *ret_size = sizeof(*header) + pixels;
+
+done:
+    png_image_free( &image );
+    return header;
+}
